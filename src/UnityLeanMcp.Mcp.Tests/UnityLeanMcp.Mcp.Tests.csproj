<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>UnityLeanMcp.Mcp.Tests.TestProcessEntryPoint</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityLeanMcp.Mcp\UnityLeanMcp.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\**" />
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\UnityLeanMcp.Unity3d\Packages\com.pereviader.unityleanmcp\Editor\RoslynCompilerHelper.cs" Link="RoslynCompilerHelper.cs">
      <Nullable>disable</Nullable>
    </Compile>
    <Compile Include="..\UnityLeanMcp.Unity3d\Packages\com.pereviader.unityleanmcp\Editor\WorkerThreadSnapshots.cs" Link="WorkerThreadSnapshots.cs">
      <Nullable>disable</Nullable>
    </Compile>
    <Compile Include="..\UnityLeanMcp.Unity3d\Packages\com.pereviader.unityleanmcp\Editor\OperationStateCache.cs" Link="OperationStateCache.cs">
      <Nullable>disable</Nullable>
    </Compile>
    <Compile Include="..\UnityLeanMcp.Unity3d\Packages\com.pereviader.unityleanmcp\Editor\WorkerDiagnosticsLogger.cs" Link="WorkerDiagnosticsLogger.cs">
      <Nullable>disable</Nullable>
    </Compile>
    <Compile Include="..\UnityLeanMcp.Unity3d\Packages\com.pereviader.unityleanmcp\Editor\ServerThreadShutdown.cs" Link="ServerThreadShutdown.cs">
      <Nullable>disable</Nullable>
    </Compile>
    <Compile Include="..\UnityLeanMcp.Unity3d\Packages\com.pereviader.unityleanmcp\Editor\UnityLeanMcpStaticHistoryWriter.cs" Link="UnityLeanMcpStaticHistoryWriter.cs">
      <Nullable>disable</Nullable>
    </Compile>
    <Compile Include="..\UnityLeanMcp.Unity3d\Packages\com.pereviader.unityleanmcp\Editor\McpConfigurationPaths.cs" Link="McpConfigurationPaths.cs">
      <Nullable>disable</Nullable>
    </Compile>
  </ItemGroup>

</Project>
